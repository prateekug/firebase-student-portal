rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 🔹 Match both "labs" and "faculty" paths
    // The previous rule only matched "labs", but your code uploads to "faculty"
    match /{path=**} {
      
      // Allow read for everyone (so students can watch)
      allow read: if true;

      // Allow write if user is authenticated
      // (Simplified for debugging - we can make it stricter later if needed)
      allow write: if request.auth != null;
    }
  }
}
